# copy to .env and adjust if needed

# input for the preprocess step (use ./data/sample to try the stack without a download)
DATA_DIR=./data/eea_e1a_2024

# fallback source for the data download (see downloader/)
EEA_MIRROR_URL=https://github.com/kbecker21/DLMDWWDE02-DataEngineering-Projekt/releases/download/data-v1/eea_e1a_2024.zip
DOWNLOAD_WORKERS=8

# kafka
KAFKA_TOPIC=sensor-events
KAFKA_HOST_PORT=29092
KAFKA_UI_PORT=8080

# replay: event time runs REPLAY_SPEED x faster than wall clock (1440 = one day per minute)
REPLAY_SPEED=1440
# share of events delivered 1-4 h late in event time, 0 = off (e.g. 0.02)
LATE_EVENT_RATE=0
