{
  "uid": "air-quality",
  "title": "Air quality 2024",
  "timezone": "utc",
  "refresh": "10s",
  "time": { "from": "2024-01-01T00:00:00.000Z", "to": "2025-01-01T00:00:00.000Z" },
  "templating": {
    "list": [
      {
        "name": "station",
        "label": "Station",
        "type": "query",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb" },
        "query": "SELECT DISTINCT station_id FROM agg_tumbling_6h ORDER BY 1",
        "definition": "SELECT DISTINCT station_id FROM agg_tumbling_6h ORDER BY 1",
        "refresh": 1,
        "sort": 1,
        "current": { "text": "DEBE010", "value": "DEBE010" }
      },
      {
        "name": "pollutant",
        "label": "Pollutant",
        "type": "custom",
        "query": "NO2,O3,PM10,PM25",
        "multi": true,
        "includeAll": true,
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [
          { "text": "All", "value": "$__all", "selected": true },
          { "text": "NO2", "value": "NO2", "selected": false },
          { "text": "O3", "value": "O3", "selected": false },
          { "text": "PM10", "value": "PM10", "selected": false },
          { "text": "PM25", "value": "PM25", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Events aggregated",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb" },
      "fieldConfig": { "defaults": { "unit": "locale", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(n_values), 0) AS events FROM agg_tumbling_6h" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stations",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT station_id) AS stations FROM agg_tumbling_6h" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latest window end (event time)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true,
          "rawSql": "SELECT coalesce(to_char(max(window_end), 'YYYY-MM-DD HH24:MI'), 'no data') AS latest FROM agg_tumbling_6h" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last write",
      "description": "Wall-clock seconds since the last sink upsert. Red once the processor has not written for a minute.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 60 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM now() - max(updated_at))::bigint AS ago FROM agg_tumbling_6h" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "6 h mean, $station",
      "description": "avg_value from agg_tumbling_6h, plotted at the window start.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb" },
      "fieldConfig": {
        "defaults": {
          "unit": "conμgm3",
          "custom": { "drawStyle": "line", "lineWidth": 1, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true,
          "rawSql": "SELECT window_start AS \"time\", pollutant AS metric, avg_value FROM agg_tumbling_6h WHERE $__timeFilter(window_start) AND station_id = '$station' AND pollutant IN (${pollutant:sqlstring}) ORDER BY 1" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "24 h mean PM10 / PM2.5, $station",
      "description": "avg_value from agg_sliding_24h, plotted at the window end. Windows with fewer than 18 of 24 hourly values are left out. Dashed line: EU daily limit value for PM10 (50 µg/m³).",
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 13 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb" },
      "fieldConfig": {
        "defaults": {
          "unit": "conμgm3",
          "custom": { "drawStyle": "line", "lineWidth": 1, "showPoints": "never", "spanNulls": false, "thresholdsStyle": { "mode": "dashed" } },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": 50 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true,
          "rawSql": "SELECT window_end AS \"time\", pollutant AS metric, avg_value FROM agg_sliding_24h WHERE $__timeFilter(window_end) AND station_id = '$station' AND n_values >= 18 ORDER BY 1" }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Highest 24 h PM10 means in range",
      "description": "Per station: highest 24 h mean and number of hourly windows above 50 µg/m³. Windows with fewer than 18 values are left out.",
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 13 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max 24 h mean" }, "properties": [ { "id": "unit", "value": "conμgm3" }, { "id": "decimals", "value": 1 } ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true,
          "rawSql": "SELECT station_id AS station, max(avg_value) AS \"max 24 h mean\", count(*) FILTER (WHERE avg_value > 50) AS \"hours above 50\" FROM agg_sliding_24h WHERE $__timeFilter(window_end) AND pollutant = 'PM10' AND n_values >= 18 GROUP BY 1 ORDER BY 2 DESC LIMIT 10" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Events per 6 h window, all stations",
      "description": "sum(n_values) from agg_tumbling_6h. Grows at the right edge while the replay runs.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never" },
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawQuery": true,
          "rawSql": "SELECT window_start AS \"time\", sum(n_values) AS events FROM agg_tumbling_6h WHERE $__timeFilter(window_start) GROUP BY 1 ORDER BY 1" }
      ]
    }
  ],
  "schemaVersion": 41,
  "version": 1
}
